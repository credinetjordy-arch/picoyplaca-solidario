        </svg>
      </div>
      <p class="pico-start__title">Iniciar <b>Solicitud</b></p>
    </div>
    <div class="pico-start__line"></div>
    <div class="pico-start__sub">
      <p>Inicia tu registro para obtener el permiso o</p>
      <p>consulta el estado de tus solicitudes en trámite</p>
    </div>
  </div>

  <div class="pico-start__card">
    <form class="pico-start__form" action="/Registro" method="get" data-pico-start>
      <div class="pico-start__fields">
        <div class="pico-start__field">
          <label for="tipoDocumento">
            <b>Tipo de Documento</b>:
          </label>
          <select id="tipoDocumento" name="tipoDocumento" required>
            <option value="">--- Seleccionar ---</option>
            <option value="1">Cédula de ciudadanía</option>
            <option value="2">Cédula de Extranjería</option>
            <option value="3">Tarjeta de Identidad</option>
            <option value="4">Pasaporte</option>
            <option value="5">Carnet Diplomático</option>
            <option value="6">Registro Civil</option>
            <option value="7">Permiso por Protección Temporal</option>
            <option value="8">NIT</option>
          </select>
        </div>
        <div class="pico-start__field">
          <label for="numeroDocumento">
            <b>Número de Documento</b>:
          </label>
          <input id="numeroDocumento" name="numeroDocumento" type="text" required />
        </div>
      </div>

      <div class="pico-start__captcha-row">
        <div class="pico-start__captcha" data-recaptcha>
          <button type="button" class="pico-start__check" aria-pressed="false" aria-label="I'm not a robot">
            <span></span>
          </button>
          <span class="pico-start__captcha-text">I'm not a robot</span>
          <div class="pico-start__captcha-brand">
            <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
              <path fill="#1c3aa9" d="M16 2l12 6.5v9.8c0 7.4-5.1 14.2-12 16.7C9.1 32.5 4 25.7 4 18.3V8.5L16 2z"></path>
              <path fill="#4285f4" d="M16 6.2l8 4.3v6.8c0 4.9-3.3 9.4-8 11.1-4.7-1.7-8-6.2-8-11.1V10.5l8-4.3z"></path>
              <path fill="#fff" d="M15.1 20.6l-3.3-3.3 1.4-1.4 1.9 1.9 4.7-4.7 1.4 1.4z"></path>
            </svg>
            <small>reCAPTCHA</small>
            <em>Privacy - Terms</em>
          </div>
        </div>
        <button type="submit" disabled>Comenzar registro</button>
      </div>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector('[data-pico-start]');
  if (form instanceof HTMLFormElement) {
    const captcha = form.querySelector('[data-recaptcha]');
    const check = form.querySelector('.pico-start__check');
    const submit = form.querySelector('button[type="submit"]');
    const tipo = form.querySelector('#tipoDocumento');
    const numero = form.querySelector('#numeroDocumento');

    const sync = () => {
      if (!(submit instanceof HTMLButtonElement)) return;
      const checked = captcha?.classList.contains('is-checked');
      const hasTipo = tipo instanceof HTMLSelectElement && tipo.value !== '';
      const hasNumero = numero instanceof HTMLInputElement && numero.value.trim() !== '';
      submit.disabled = !(checked && hasTipo && hasNumero);
    };

    check?.addEventListener('click', () => {
      captcha?.classList.toggle('is-checked');
      check.setAttribute('aria-pressed', String(captcha?.classList.contains('is-checked')));
      sync();
    });

    form.addEventListener('input', sync);
    form.addEventListener('change', sync);
  }
</script>

<style is:global>
  .pico-start {
    background-color: #00271c;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: 0 auto;
  }

  .pico-start__intro {
    margin-top: 5%;
  }

  .pico-start__icon {
    display: flex;
    justify-content: center;
  }

  .pico-start__title {
    margin: 0;
    color: #fff;
    font-size: 36px;
    font-weight: 400;
    line-height: 40px;
  }

  .pico-start__title b {
    font-weight: 700;
  }

  .pico-start__line {
    width: 70%;
    margin: 0 auto;
    border-bottom: 1px solid #88f456;
  }

  .pico-start__sub {
    margin: 32px 0;
  }

  .pico-start__sub p {
    margin: 0;
    color: #fff;
    font-size: 16px;
    line-height: 24px;
  }

  .pico-start__card {
    width: 70%;
    background: #fff;
    border-radius: 8px;
    margin-bottom: 5%;
  }

  .pico-start__form {
    margin: 0 20px;
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .pico-start__fields {
    width: 90%;
  }

  .pico-start__field {
    width: 100%;
    padding: 0 8px;
    margin-bottom: 16px;
    text-align: left;
  }

  .pico-start__field label {
    display: flex;
    font-size: 16px;
    font-weight: 500;
    color: #00271c;
  }

  .pico-start__field b {
    font-weight: 700;
    margin-right: 0;
  }

  .pico-start__field select,
  .pico-start__field input {
    margin-top: 4px;
    display: block;
    width: 100%;
    padding: 8px 12px;
    border: 0.8px solid #00271c;
    border-radius: 6px;
    background: #fff;
    color: #00271c;
    font-size: 16px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
    outline: none;
    box-sizing: border-box;
  }

  .pico-start__captcha-row {
    width: 100%;
    padding: 0 8px 0;
    margin-top: 12px;
  }

  .pico-start__captcha {
    width: 304px;
    height: 78px;
    margin: 0 auto 8px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 12px 0 14px;
    border: 1px solid #d3d3d3;
    background: #f9f9f9;
    box-sizing: border-box;
  }

  .pico-start__check {
    width: 28px;
    height: 28px;
    padding: 0;
    border: 2px solid #c1c1c1;
    border-radius: 2px;
    background: #fff;
    cursor: pointer;
    flex-shrink: 0;
  }

  .pico-start__check span {
    display: none;
    width: 16px;
    height: 10px;
    margin: 4px auto 0;
    border-left: 3px solid #1c8a3a;
    border-bottom: 3px solid #1c8a3a;
    transform: rotate(-45deg);
  }

  .pico-start__captcha.is-checked .pico-start__check span {
    display: block;
  }

  .pico-start__captcha-text {
    flex: 1;
    text-align: left;
    color: #000;
    font-size: 14px;
    font-weight: 400;
  }

  .pico-start__captcha-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #555;
    min-width: 70px;
  }

  .pico-start__captcha-brand small {
    font-size: 10px;
    line-height: 1.1;
  }

  .pico-start__captcha-brand em {
    font-style: normal;
    font-size: 8px;
    color: #555;
  }

  .pico-start__form button[type='submit'] {
    display: inline-block;
    margin: 20px auto 20px;
    padding: 8px;
    border: 0;
    border-radius: 9999px;
    background: #00271c;
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    line-height: 16px;
    cursor: pointer;
  }

  .pico-start__form button[type='submit']:disabled {
    opacity: 0.5;
    cursor: default;
  }

  @media (max-width: 1000px) {
    .pico-start__header {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .pico-start__title {
      font-size: 4.5rem;
      margin-left: 1rem;
      line-height: 4rem;
    }

    .pico-start__line {
      visibility: hidden;
    }

    .pico-start__sub p {
      font-size: 2.2rem;
      line-height: 50px;
    }
  }

  @media (max-width: 576px) {
    .pico-start__card {
      width: 80%;
    }
  }
</style>
