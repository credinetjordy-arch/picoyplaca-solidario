            c8.1,3.3,10.2,12.9,3.8,19.7c-7.3,7.8-15.3,15-23,22.4c-19.2,18.4-38.3,36.7-57.5,55c-6.7,6.4-12.3,6.6-19.5,0.9
            c-17.8-14.2-35.7-28.3-53.4-42.6c-2.8-2.3-5.8-5.2-7-8.5c-2-5.2-0.6-10.1,4.4-13.6c4.9-3.4,9.8-3,14.3,0.5
