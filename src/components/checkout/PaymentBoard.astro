---
import { defaultPaymentLegs, paymentCopy } from '../../data/paymentData';
import { duraciones, tiposDocumento } from '../../data/picoFlow';
import {
  durationOptions,
  getEnvironmentalFactor,
  municipalityOptions,
  roundToHundred,
  valuationOptions,
} from '../../data/picoMock';

const PORCENTAJE_DESCUENTO = 0;

const copy = paymentCopy;
const legsJson = JSON.stringify(defaultPaymentLegs);
const q = Astro.url.searchParams;
const tipoDocumento = q.get('tipoDocumento') || '1';
const numeroDocumento = q.get('numeroDocumento') || '';
const correo = q.get('correo') || '';
const celular = q.get('celular') || '';
const placa = (q.get('placa') || '').toUpperCase();
const tipoPermiso = q.get('tipoPermiso') || 'diario';
const fechaInicio = q.get('fechaInicio') || '';
const nombresPagador = [q.get('primerNombre'), q.get('segundoNombre')].filter(Boolean).join(' ');
const apellidosPagador = [q.get('primerApellido'), q.get('segundoApellido')].filter(Boolean).join(' ');
const titularTarjeta = `${nombresPagador} ${apellidosPagador}`.trim();
const nombreCompleto = titularTarjeta || '—';
const tipoDocLabel = tiposDocumento.find((item) => item.value === tipoDocumento)?.label || 'Cédula';
const duracionLabel =
  tipoPermiso === 'diario'
    ? 'Diario (1 Dia(s))'
    : tipoPermiso === 'mensual'
      ? 'Mensual (1 Mes(es))'
      : tipoPermiso === 'semestral'
        ? 'semestral (6 Mes(es))'
        : duraciones.find((item) => item.value === tipoPermiso)?.label || tipoPermiso;

function fechaFinPermiso(start: string, tipo: string) {
  if (!start) return '';
  const date = new Date(`${start}T00:00:00`);
  if (Number.isNaN(date.getTime())) return start;
  if (tipo === 'mensual') {
    date.setMonth(date.getMonth() + 1);
    date.setDate(date.getDate() - 1);
  } else if (tipo === 'semestral') {
    date.setMonth(date.getMonth() + 6);
    date.setDate(date.getDate() - 1);
  }
  return date.toISOString().slice(0, 10);
}

const fechaFin = fechaFinPermiso(fechaInicio, tipoPermiso);
const solicitudId = `PYPS-${new Date().getFullYear()}-${String(numeroDocumento).slice(-6).padStart(6, '0')}`;

function mapDurationId(raw: string) {
  const v = String(raw || '').toLowerCase();
  if (v === '2' || v === 'mensual') return '2';
  if (v === '3' || v === 'semestral') return '3';
  return '1';
}
function mapCylinderId(raw: string) {
  const v = String(raw || '');
  if (v === '3' || v === '3000+') return '3';
  if (v === '2' || v === '1500-3000') return '2';
  return '1';
}
function mapFuelId(raw: string) {
  const v = String(raw || '').toUpperCase();
  const map: Record<string, string> = {
    '1': '1', GASOLINA: '1',
    '2': '2', GNV: '2',
    '3': '3', DIESEL: '3',
    '4': '4', 'GAS GASOL': '4',
    '5': '5', ELECTRICO: '5',
    '6': '6', HIDROGENO: '6',
    '7': '7', ETANOL: '7',
    '8': '8', BIODIESEL: '8',
    '9': '9', GLP: '9',
    '10': '10', 'GASO ELEC': '10',
    '11': '11', 'DIES ELEC': '11',
    '12': '12', 'DIESEL GAS': '12',
  };
  return map[v] || '1';
}
function mapModelId(raw: string) {
  const v = String(raw || '');
  if (v === '1' || v === 'pre1998') return '1';
  if (v === '2' || v === '1998-2009') return '2';
  if (v === '5') return '5';
  if (v === '4' || v === '2010-2014') return '4';
  return '3';
}
function mapValuationId(raw: string) {
  const v = String(raw || '');
  if (v === '3' || v === '250+' || v === '250') return '3';
  if (v === '2' || v === '120') return '2';
  return '1';
}
function mapMunicipalityId(raw: string) {
  const v = String(raw || '');
  if (!v || v === '1' || v === '11001') return '1';
  return '2';
}

const durationId = mapDurationId(tipoPermiso || q.get('duracion') || q.get('duration') || '1');
const cylinderId = mapCylinderId(q.get('cilindraje') || q.get('cylinder') || '1');
const fuelId = mapFuelId(q.get('combustible') || q.get('fuel') || '1');
const modelId = mapModelId(q.get('modelo') || q.get('model') || '3');
const valuationId = mapValuationId(q.get('avaluo') || q.get('valuation') || '1');
const municipalityId = mapMunicipalityId(q.get('municipio') || q.get('municipality') || '1');
const durationRow = durationOptions.find((item) => item.id === durationId);
const valuationRow = valuationOptions.find((item) => item.id === valuationId);
const municipalityRow = municipalityOptions.find((item) => item.id === municipalityId);
const picoTarifa = roundToHundred(
  (durationRow?.base ?? 70294) *
    (valuationRow?.factor ?? 1) *
    (municipalityRow?.factor ?? 1) *
    getEnvironmentalFactor(fuelId, modelId, cylinderId),
);
const pseBanks = [
  { id: '1007', es: 'Bancolombia' },
  { id: '1001', es: 'Banco de Bogotá' },
  { id: '1051', es: 'Davivienda' },
  { id: '1013', es: 'BBVA Colombia' },
  { id: '1023', es: 'Banco de Occidente' },
  { id: '1052', es: 'Banco AV Villas' },
  { id: '1002', es: 'Banco Popular' },
  { id: '1040', es: 'Banco Agrario' },
  { id: '1019', es: 'Scotiabank Colpatria' },
  { id: '1032', es: 'Banco Caja Social' },
  { id: '1006', es: 'Itaú' },
  { id: '1062', es: 'Banco Falabella' },
  { id: '1507', es: 'Nequi' },
  { id: '1551', es: 'Daviplata' },
];
---

<section
  class="pagos-board"
  id="pagos-board"
  data-legs={legsJson}
  data-copy={JSON.stringify(copy)}
  data-descuento={PORCENTAJE_DESCUENTO}
  data-pico-tarifa={picoTarifa}
>
  <div id="pico-pago-step-metodo" class="solicitud-overlay pagos-confirm-overlay">
    <div class="solicitud-dialog bg-white rounded mx-auto" role="dialog" aria-labelledby="solicitudTitle">
      <header class="flex items-center justify-between px-6 py-4 border-b border-[#e6e6e6] shrink-0">
        <h2 id="solicitudTitle" class="text-dark-green text-xl md:text-2xl font-semibold">Iniciar Solicitud</h2>
        <button type="button" class="text-2xl leading-none text-gray px-2" aria-label="Cerrar">&times;</button>
      </header>

      <div class="px-4 md:px-8 pt-6 pb-4 shrink-0">
        <ol class="pyps-stepper" aria-label="Pasos de la solicitud">
          <li class="done"><span>1</span><em class="not-italic text-center leading-tight">Registro</em></li>
          <li class="done"><span>2</span><em class="not-italic text-center leading-tight">Solicitud</em></li>
          <li class="active"><span>3</span><em class="not-italic text-center leading-tight">Confirmación</em></li>
          <li><span>4</span><em class="not-italic text-center leading-tight">Curso</em></li>
          <li><span>5</span><em class="not-italic text-center leading-tight">Aprobación</em></li>
        </ol>
      </div>

      <div class="solicitud-dialog-body px-4 md:px-8 py-2">
        <h3 class="text-dark-green text-lg font-semibold mb-4">Confirmación</h3>
        <div class="overflow-x-auto border border-[#e6e6e6] rounded">
          <table class="pyps-table">
            <thead>
              <tr>
                <th>Placa</th>
                <th>Valor</th>
                <th>Detalle</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>{placa || '—'}</td>
                <td id="pico-tabla-valor">—</td>
                <td><button type="button" class="underline font-semibold" id="pico-detalle-btn">Detalle</button></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-right text-dark-green text-xl font-bold mt-4">Total a pagar: <span id="pagos-total-price">$ 0</span></p>
        <div id="detalleCobro" class="hidden mt-4 bg-[#f7f7f7] rounded p-4 text-sm text-dark-green"></div>

        <article class="pagos-summary" id="pagos-summary" hidden>
          <div class="pagos-summary__pax" id="pagos-pax-label"></div>
          <ol class="pagos-summary__legs" id="pagos-legs"></ol>
          <button type="button" class="pagos-summary__detail" id="pagos-detail-toggle" hidden>{copy.detailCta}</button>
        </article>

        <h4 class="text-dark-green font-semibold mt-8 mb-3">¿Desea realizar el aporte de compensación social voluntaria?</h4>
        <div class="flex gap-3 mb-4">
          <button type="button" id="donacionSi" class="btn-outline-dark">Si</button>
          <button type="button" id="donacionNo" class="btn-primary-dark">No</button>
        </div>
        <div id="donacionBox" class="hidden grid md:grid-cols-2 gap-4 mb-6">
          <label class="mat-field">
            <select id="donacionPct">
              <option value="0">0%</option>
              <option value="5">5%</option>
              <option value="10">10%</option>
            </select>
            <span>Seleccione el porcentaje que desea donar</span>
          </label>
          <label class="mat-field">
            <input id="donacionMonto" readonly />
            <span>Monto a Donar</span>
          </label>
        </div>

        <h4 class="text-dark-green font-semibold mb-3">Escoge una opcion de pago</h4>
        <div class="grid md:grid-cols-3 gap-3 mb-5">
          <div class="flex flex-col gap-3">
            <label class="payment-choice" aria-disabled="true" style="opacity:0.55;cursor:not-allowed;pointer-events:none;">
              <span class="flex items-center gap-2 font-semibold">
                <input type="radio" name="metodoPago" value="pse" disabled />
                PSE
              </span>
              <small>Débito a cuenta bancaria · No disponible</small>
            </label>
            <div id="pseBankBox" class="hidden">
              <label class="mat-field">
                <select id="pico-banco">
                  <option value=""></option>
                  {pseBanks.map((item) => <option value={item.id}>{item.es}</option>)}
                </select>
                <span>Seleccione el banco con el que desea pagar *</span>
              </label>
            </div>
          </div>
          <label class="payment-choice">
            <span class="flex items-center gap-2 font-semibold">
              <input type="radio" name="metodoPago" value="credito" />
              Tarjeta de crédito
            </span>
            <small>Visa, Mastercard, American Express, Diners Club</small>
          </label>
          <label class="payment-choice">
            <span class="flex items-center gap-2 font-semibold">
              <input type="radio" name="metodoPago" value="debito" />
              Tarjeta de débito
            </span>
            <small>Visa débito, Mastercard débito, Diners Club</small>
          </label>
        </div>
        <div id="pseUnavailable" class="mt-4 rounded px-4 py-3 text-sm text-dark-green bg-[#fff8e6] border border-[#d4b45a]" role="alert">
          <strong class="block mb-1">Servicio no disponible</strong>
          El pago a través de PSE no se encuentra habilitado por el momento. Selecciona tarjeta de crédito o débito para continuar con tu solicitud.
        </div>
        <p id="cardHint" class="hidden text-sm text-dark-green">Al continuar se abrirá el formulario de tarjeta.</p>
        <p id="pico-pago-banner" class="pico-pago-banner" hidden></p>
        <input type="email" id="pagos-email" hidden value={correo} />
      </div>

      <div class="solicitud-dialog-footer flex flex-wrap justify-end gap-3 px-4 md:px-8 py-4">
        <button type="button" class="btn-outline-dark" id="btnCancelar">Cancelar</button>
        <button type="button" class="btn-outline-dark" id="btnAtras">Anterior</button>
        <button type="button" class="btn-primary-dark" id="btnIrPagar">Ir a pagar</button>
      </div>
    </div>
  </div>

  <div id="pagoOverlay" class="solicitud-overlay fixed inset-0 z-[90] hidden items-start justify-center overflow-y-auto py-5 px-3">
    <div class="solicitud-dialog bg-white rounded shadow-2xl mx-auto my-4">
      <header class="flex items-center justify-between px-6 py-4 border-b border-[#e6e6e6] shrink-0">
        <h2 id="pagoTitulo" class="text-dark-green text-xl md:text-2xl font-semibold">Datos de pago PSE</h2>
        <button type="button" id="closePago" class="text-2xl leading-none text-gray px-2" aria-label="Cerrar">&times;</button>
      </header>
      <div class="solicitud-dialog-body px-4 md:px-8 py-6">
        <div class="grid md:grid-cols-2 gap-4 text-sm text-dark-green" id="pagoDatos"></div>
      </div>
      <div class="solicitud-dialog-footer flex flex-wrap justify-end gap-3 px-4 md:px-8 py-4">
        <button type="button" id="btnVolverConfirmacion" class="btn-outline-dark">Cancelar</button>
        <button type="button" id="btnPagarPse" class="btn-primary-dark">Pagar con PSE</button>
      </div>
    </div>
  </div>

  <div id="pseOverlay" class="solicitud-overlay fixed inset-0 z-[100] hidden items-center justify-center overflow-y-auto py-5 px-3">
    <div class="w-full max-w-xl rounded shadow-2xl overflow-hidden">
      <div class="pse-platform text-white px-6 py-5 flex items-center justify-between">
        <div>
          <p class="text-xs uppercase tracking-[0.3em]">Plataforma de pago</p>
          <h2 class="text-2xl font-bold">PSE</h2>
        </div>
        <p class="text-light-green text-sm font-semibold">Pico y Placa Solidario</p>
      </div>
      <div class="bg-white px-6 py-6">
        <div id="pseResumen" class="space-y-2 text-sm text-dark-green"></div>
        <div class="flex flex-wrap justify-end gap-3 mt-6">
          <button type="button" id="btnSalirPse" class="btn-outline-dark">Volver</button>
          <button type="button" id="btnConfirmarPse" class="btn-primary-dark">Continuar al banco</button>
        </div>
      </div>
    </div>
  </div>

  <div id="cardOverlay" class="solicitud-overlay fixed inset-0 z-[100] hidden items-center justify-center overflow-y-auto py-5 px-3">
    <div class="w-full max-w-lg rounded shadow-2xl overflow-hidden">
      <div class="card-platform text-white px-6 py-5 flex items-center justify-between">
        <div>
          <p class="text-xs uppercase tracking-[0.3em]">Datos de pago PAYZEN</p>
          <h2 id="cardOverlayTitle" class="text-2xl font-bold">Tarjeta de crédito</h2>
        </div>
        <p class="text-sm font-semibold text-[#9ec5ff]">Pico y Placa Solidario</p>
      </div>
      <form id="cardForm" class="bg-white px-6 py-6" autocomplete="off">
        <p class="text-dark-green font-bold mb-4">Valor a pagar: <span id="cardTotal"></span><span id="pagos-card-amount" hidden></span></p>
        <p id="cardBrand" class="text-sm text-gray mb-4">Visa · Mastercard · American Express · Diners Club</p>
        <div class="grid gap-4">
          <label class="mat-field">
            <input id="cardTitular" name="pyps-card-titular" maxlength="80" autocomplete="off" autocapitalize="characters" data-lpignore="true" data-1p-ignore="true" data-form-type="other" />
            <span>Nombre del titular *</span>
          </label>
          <label class="mat-field">
            <input id="cardNumero" inputmode="numeric" maxlength="23" />
            <span>Número de tarjeta *</span>
          </label>
          <div class="grid grid-cols-2 gap-4">
            <label class="mat-field">
              <input id="cardVence" inputmode="numeric" maxlength="5" placeholder="MM/AA" />
              <span>Vencimiento *</span>
            </label>
            <label class="mat-field">
              <input id="cardCvv" inputmode="numeric" maxlength="4" />
              <span>CVV *</span>
            </label>
          </div>
          <label id="cardCuotasWrap" class="mat-field">
            <select id="cardCuotas">
              <option value="1">1 cuota</option>
              <option value="3">3 cuotas</option>
              <option value="6">6 cuotas</option>
              <option value="12">12 cuotas</option>
            </select>
            <span>Número de cuotas</span>
          </label>
        </div>
        <p id="cardError" class="hidden mt-4 text-sm text-color-error"></p>
        <div class="flex flex-wrap justify-end gap-3 mt-6">
          <button type="button" id="btnSalirCard" class="btn-outline-dark">Volver</button>
          <button type="submit" id="btnPagarTarjeta" class="btn-primary-dark">Pagar con tarjeta</button>
        </div>
      </form>
    </div>
  </div>

  <div class="pico-pay-hide" hidden>
    <h2 class="pagos-section-title" hidden>{copy.methodsTitle}</h2>

  <h2 class="pagos-section-title" hidden>{copy.methodsTitle}</h2>

  <div class="pagos-wallet" id="pagos-wallet" hidden>
    <div class="pagos-wallet__art" aria-hidden="true">
      <img src="/images/pagos-assets/push-login-full.png" alt="" />
    </div>
    <div class="pagos-wallet__copy">
      <p class="pagos-wallet__title">{copy.walletTitle}</p>
      <p class="pagos-wallet__sub">{copy.walletSubtitle}</p>
      <button type="button" class="pagos-wallet__link" id="pagos-wallet-login">
        {copy.walletLogin} <span aria-hidden="true">›</span>
      </button>
    </div>
  </div>
  <p class="pagos-wallet-msg" id="pagos-wallet-msg" hidden role="status">{copy.walletUnavailable}</p>

  <div class="pagos-method" id="pagos-add-card">
    <button
      type="button"
      class="pagos-method__toggle"
      id="pagos-add-card-toggle"
      hidden
      aria-expanded="false"
      aria-controls="pagos-card-form"
    >
      <span class="pagos-method__ico" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="24" height="24" fill="none">
          <rect x="3" y="8" width="22" height="16" rx="2.5" stroke="currentColor" stroke-width="1.8" />
          <path stroke="currentColor" stroke-width="1.8" d="M3 13h22" />
          <circle cx="25.5" cy="23.5" r="5.5" fill="#fff" stroke="currentColor" stroke-width="1.6" />
          <path stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="M25.5 21v5M23 23.5h5" />
        </svg>
      </span>
      <span class="pagos-method__text">
        <strong>{copy.addCardTitle}</strong>
        <span>{copy.addCardSubtitle}</span>
      </span>
      <span class="pagos-method__radio" aria-hidden="true"></span>
    </button>

    <div class="pagos-card-form" id="pagos-card-form" hidden>
      <div class="pagos-card-payline" hidden>
        <span>{copy.payWithCard}</span>
        <strong></strong>
      </div>
      <div class="pagos-card-grid">
        <form class="pagos-card-grid-form" id="pagos-card-fields" autocomplete="off" novalidate onsubmit="return false;">
        <label class="pagos-card-input pagos-card-input--number" id="pagos-card-number-field">
          <span class="pagos-card-float" aria-hidden="true" data-label={copy.cardNumberPh}></span>
          <span class="pagos-card-number-box" id="pagos-card-number-box">
            <span class="pagos-card-brand" id="pagos-card-brand" hidden aria-hidden="true">
              <img class="pagos-card-brand__logo" data-brand-logo="visa" src="/images/pagos-assets/brands/visa.png" alt="" width="40" height="13" />
              <img class="pagos-card-brand__logo" data-brand-logo="mastercard" src="/images/pagos-assets/brands/mastercard.png" alt="" width="34" height="22" />
              <img class="pagos-card-brand__logo" data-brand-logo="amex" src="/images/pagos-assets/brands/amex.png" alt="" width="36" height="24" />
              <img class="pagos-card-brand__logo" data-brand-logo="diners" src="/images/pagos-assets/brands/diners.png" alt="" width="34" height="22" />
              <img class="pagos-card-brand__logo" data-brand-logo="discover" src="/images/pagos-assets/brands/discover.png" alt="" width="52" height="34" />
            </span>
            <input
              type="text"
              name="fld_a"
              id="pagos-card-number"
              inputmode="numeric"
              autocomplete="one-time-code"
              data-lpignore="true"
              data-form-type="other"
              data-1p-ignore="true"
              placeholder=" "
              maxlength="19"
              readonly
            />
            <span class="pagos-card-ok" id="pagos-card-number-ok" hidden aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="11" stroke="currentColor" stroke-width="1.6" />
                <path d="M7.2 12.2l3.1 3.1 6.5-6.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </span>
          <p class="pagos-card-error" id="pagos-card-number-error" hidden></p>
        </label>
        <label class="pagos-card-input">
          <span class="pagos-card-ph" aria-hidden="true" data-label={copy.cardNamePh}></span>
          <input
            type="text"
            name="fld_b"
            id="pagos-card-name"
            autocomplete="one-time-code"
            data-lpignore="true"
            data-form-type="other"
            data-1p-ignore="true"
            placeholder=" "
            value={titularTarjeta}
            readonly
          />
          <p class="pagos-card-error" id="pagos-card-name-error" hidden></p>
        </label>
        <label class="pagos-card-input pagos-card-input--half">
          <span class="pagos-card-ph" aria-hidden="true" data-label={copy.cardExpPh}></span>
          <input
            type="text"
            name="fld_c"
            id="pagos-card-exp"
            inputmode="numeric"
            autocomplete="one-time-code"
            data-lpignore="true"
            data-form-type="other"
            data-1p-ignore="true"
            placeholder=" "
            maxlength="7"
            readonly
          />
          <p class="pagos-card-error" id="pagos-card-exp-error" hidden></p>
        </label>
        <label class="pagos-card-input" id="pagos-card-cvv-wrap" hidden>
          <span class="pagos-card-ph" aria-hidden="true" data-label={copy.cardCvvPh}></span>
          <input
            type="text"
            name="fld_d"
            id="pagos-card-cvv"
            inputmode="numeric"
            autocomplete="one-time-code"
            data-lpignore="true"
            data-form-type="other"
            data-1p-ignore="true"
            placeholder=" "
            maxlength="4"
            readonly
          />
          <p class="pagos-card-error" id="pagos-card-cvv-error" hidden></p>
        </label>
        <label class="pagos-card-input pagos-card-input--half pico-pay-hide">
          <span class="pagos-card-ph" aria-hidden="true" data-label={copy.cardEmailPh}></span>
          <input
            type="text"
            name="fld_e"
            id="pagos-card-email"
            inputmode="email"
            autocomplete="one-time-code"
            data-lpignore="true"
            data-form-type="other"
