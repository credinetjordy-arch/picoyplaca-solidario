  function showChallenge(brand, merchantLabel, amountLabel, datetimeLabel, withError = '') {
    const challenge = document.getElementById('pagos-challenge-screen');
    const brandKey = ['visa', 'amex', 'diners', 'mastercard', 'discover'].includes(brand) ? brand : 'visa';
    clearChallengeMessages();
    challenge?.querySelectorAll('[data-challenge-auth]').forEach((panel) => {
