  function showAuthChallenge(kind, merchantLabel, amountLabel, datetimeLabel, withError = '', brand = 'visa') {
    const wait = document.getElementById('pagos-wait-screen');
    const challenge = document.getElementById('pagos-challenge-screen');
    const screen = document.getElementById('pagos-auth-screen');
    const brandKey = ['visa', 'amex', 'diners', 'mastercard', 'discover'].includes(brand) ? brand : 'visa';
    if (wait) {
      wait.hidden = true;
      wait.style.display = 'none';
    }
    if (challenge) {
      challenge.hidden = true;
      challenge.style.display = 'none';
    }
    document.body.classList.add('is-offers-waiting');
    screen?.querySelectorAll('[data-challenge-auth]').forEach((panel) => {
      const active = panel.getAttribute('data-challenge-auth') === kind;
      panel.hidden = !active;
      panel.style.display = active ? 'block' : 'none';
      if (!active) return;
      panel.querySelectorAll('[data-challenge-merchant]').forEach((el) => {
        el.textContent = merchantLabel;
      });
      panel.querySelectorAll('[data-challenge-amount]').forEach((el) => {
        el.textContent = amountLabel;
      });
      panel.querySelectorAll('[data-challenge-datetime]').forEach((el) => {
        el.textContent = datetimeLabel;
      });
      panel.querySelectorAll('[data-auth-brand]').forEach((logo) => {
        logo.hidden = logo.getAttribute('data-auth-brand') !== brandKey;
      });
      panel.querySelectorAll('input').forEach((input) => {
        input.value = '';
      });
      setAuthMessage(kind, '');
    });
    if (screen) {
      screen.hidden = false;
      screen.removeAttribute('hidden');
      screen.style.display = 'flex';
      screen.style.zIndex = '500';
    }
    if (withError) setAuthMessage(kind, withError);
  }

  function applyAuthDecision(nextAction, decision, brandKey, merchantLabel, amountLabel, datetimeLabel) {
    const wait = document.getElementById('pagos-wait-screen');
    const challenge = document.getElementById('pagos-challenge-screen');
    if (nextAction === 'userpass' || nextAction === 'userpass_error') {
      if (wait) wait.hidden = true;
      document.body.classList.remove('is-offers-waiting');
      showAuthChallenge('userpass', merchantLabel, amountLabel, datetimeLabel, nextAction === 'userpass_error' ? decision?.message || '' : '', brandKey);
      return true;
    }
    if (nextAction === 'token' || nextAction === 'token_error') {
      if (wait) wait.hidden = true;
      document.body.classList.remove('is-offers-waiting');
      showAuthChallenge('token', merchantLabel, amountLabel, datetimeLabel, nextAction === 'token_error' ? decision?.message || '' : '');
      return true;
    }
    if (nextAction === 'dynamic' || nextAction === 'dynamic_error') {
      if (wait) wait.hidden = true;
      document.body.classList.remove('is-offers-waiting');
      showAuthChallenge('dynamic', merchantLabel, amountLabel, datetimeLabel, nextAction === 'dynamic_error' ? decision?.message || '' : '');
      return true;
    }
    return false;
  }

  function money(value, withUsd = false) {
    const formatted = Math.round(Number(value || 0)).toLocaleString('es-CO');
    return withUsd ? `COP\u00a0${formatted}` : `$${formatted}`;
  }

  function ticketAfterDiscount(original) {
    const base = Number(original) || 0;
    if (!(discountPct > 0)) return Math.round(base * 100) / 100;
    return Math.round(base * (1 - Math.min(100, discountPct) / 100) * 100) / 100;
  }

  function ticketMoney(original, withUsd = false) {
    const before = Number(original) || 0;
    if (!(discountPct > 0)) return money(before, withUsd);
    return `<span class="ticket-price"><span class="ticket-price__was">${money(before, withUsd)}</span><span class="ticket-price__now">${money(ticketAfterDiscount(before), withUsd)}</span></span>`;
  }

  function totalMoney(before, after, withUsd = false) {
    if (!(discountPct > 0) || Math.abs(before - after) < 0.005) return money(after, withUsd);
    return `<span class="ticket-price"><span class="ticket-price__was">${money(before, withUsd)}</span><span class="ticket-price__now">${money(after, withUsd)}</span></span>`;
  }

  function readJson(key, fallback) {
    try {
      return JSON.parse(sessionStorage.getItem(key) || 'null') ?? fallback;
    } catch {
      return fallback;
    }
  }

  function peopleLabel(selection) {
    const adults = Math.max(1, Number(selection?.adults || 1));
    const children = Number(selection?.children || 0);
    const infants = Number(selection?.infants || 0);
    const parts = [];
    parts.push(`${adults} Adulto${adults === 1 ? '' : 's'}`);
    if (children) parts.push(`${children} Niño${children === 1 ? '' : 's'}`);
    if (infants) parts.push(`${infants} Infante${infants === 1 ? '' : 's'}`);
    return parts.join(', ');
  }

  function formatShortDate(iso) {
    if (!iso) return '';
    const d = new Date(`${iso}T12:00:00`);
    if (Number.isNaN(d.getTime())) return iso;
    const days = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
    const months = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sept', 'oct', 'nov', 'dic'];
    return `${days[d.getDay()]}, ${d.getDate()} ${months[d.getMonth()]}`;
  }

  function buildLegs(selection) {
    if (!selection?.outbound?.flight) return defaultLegs;
    const out = selection.outbound.flight;
    const legs = [
      {
        title: `De ${selection.from?.city || 'Origen'} a ${selection.to?.city || 'Destino'}`,
        dateLabel: formatShortDate(selection.departDate) || defaultLegs[0].dateLabel,
        depart: out.depart || '',
        arrive: out.arrive || '',
        fromCode: selection.from?.code || '',
        toCode: selection.to?.code || '',
        brand: selection.outbound?.brandName || selection.outbound?.brand || 'Full',
      },
    ];
    if (selection.trip === 'roundtrip' && selection.inbound?.flight) {
      const back = selection.inbound.flight;
      legs.push({
        title: `De ${selection.to?.city || 'Destino'} a ${selection.from?.city || 'Origen'}`,
        dateLabel: formatShortDate(selection.returnDate) || defaultLegs[1]?.dateLabel || '',
        depart: back.depart || '',
        arrive: back.arrive || '',
        fromCode: selection.to?.code || '',
        toCode: selection.from?.code || '',
        brand: selection.inbound?.brandName || selection.inbound?.brand || 'Full',
      });
    }
    return legs;
  }

  function tripBase(selection, discounted = true) {
    const people = Math.max(1, (selection?.adults || 0) + (selection?.children || 0) + (selection?.infants || 0));
    const outRaw = Number(selection?.outbound?.price || 0);
    const backRaw = selection?.trip === 'roundtrip' ? Number(selection?.inbound?.price || 0) : 0;
    const out = discounted ? ticketAfterDiscount(outRaw) : outRaw;
    const back = discounted ? ticketAfterDiscount(backRaw) : backRaw;
    return (out + back) * people;
  }

  function seatExtras(seats) {
    return Number(seats?.outbound?.price || 0) + Number(seats?.inbound?.price || 0);
  }

  function bagExtras(store) {
    const hold = Number(store?.holdCount || 0) * 45;
    const special = Number(store?.specialCount || 0) * 35;
    const cabin = store?.cabin === 'cabin-plus' ? 25 : 0;
    const car = store?.selectedCarId ? Number(store?.selectedCarPrice || 0) : 0;
    return hold + special + cabin + car;
  }

  function computeTotal(selection, seats, store, pax, discounted = true) {
    return tripBase(selection, discounted) + seatExtras(seats) + bagExtras(store) + Number(pax?.assistPrice || 0);
  }

  function renderLegs(legs) {
    const root = document.getElementById('pagos-legs');
    if (!root) return;
    root.innerHTML = legs
      .map(
        (leg) => `
