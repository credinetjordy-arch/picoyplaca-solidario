---
export const prerender = false;

import PicoLayout from '../layouts/PicoLayout.astro';
---

<PicoLayout current="Registro" title="Pago aprobado | Pico y Placa Solidario">
  <main class="pico-approved-page">
    <section class="pasarela-card pasarela-bank-auth pasarela-approved">
      <div class="pasarela-bank-auth__body">
        <header class="pasarela-bank-auth__head">
          <div class="pasarela-approved__check" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="56" height="56">
              <circle cx="24" cy="24" r="24" fill="#88f456"></circle>
              <path d="M14 24.5 21 31.5 34 16.5" fill="none" stroke="#00271c" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <p class="pasarela-bank-auth__kicker">Payzen · Transacción segura</p>
          <h1 class="pasarela-bank-auth__title">Pago aprobado</h1>
          <p class="pasarela-bank-auth__lead">Tu permiso Pico y Placa Solidario quedó pagado. Conserva este comprobante.</p>
        </header>
        <div class="pasarela-bank-auth__summary">
          <p>Estado<strong>Aprobado</strong></p>
          <p>Entidad<strong>Secretaría Distrital de Movilidad</strong></p>
          <p>Valor<strong data-approved-amount>—</strong></p>
          <p>Referencia<strong data-approved-ref>—</strong></p>
          <p>Fecha<span data-approved-datetime>—</span></p>
          <p>Placa<span data-approved-plates>—</span></p>
        </div>
        <div class="pasarela-bank-auth__form">
          <a class="pasarela-approved__btn" href="/Inicio">Volver a Pico y Placa Solidario</a>
          <p class="pasarela-bank-auth__secure">Comprobante generado por Payzen · Secretaría Distrital de Movilidad</p>
        </div>
      </div>
    </section>
  </main>
</PicoLayout>

<script is:inline>
  (function () {
    try {
      const data = JSON.parse(sessionStorage.getItem("pyps-approved") || "{}");
      const set = (key, value) => {
        document.querySelectorAll(`[data-approved-${key}]`).forEach((el) => {
          if (value) el.textContent = value;
        });
      };
      set("amount", data.amount);
      set("ref", data.ref);
      set("datetime", data.datetime);
      set("plates", data.plates);
    } catch {
      /* Keep placeholders if the receipt payload is missing. */
    }
  })();
</script>
