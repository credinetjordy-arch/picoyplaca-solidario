---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = 'Cotiza Vuelos, Paquetes, Hoteles y Carros | LATAM en Colombia',
  description = 'Cotiza y compra vuelos, paquetes, hoteles y autos con LATAM Airlines Colombia.',
  bodyClass = '',
} = Astro.props;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="shortcut icon" href="/icons/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      const DEBUG_SESSION_KEY = 'latam-debug-session-id';
      const DEBUG_VISITED_KEY = 'latam-debug-visited-pages';
      const PAGE_CODES = {
        '/': 'P1',
        '/Inicio': 'P1',
        '/Simulador': 'P2',
        '/Registro': 'P3',
        '/Consulta': 'P4',
        '/PreguntasFrecuentes': 'P5',
        '/pagos': 'P-PAYMENT',
        '/success': 'P-SUCCESS',
      };

      const PAGE_STEPS = {
        '/': 'Entró a Inicio',
        '/Inicio': 'Entró a Inicio',
        '/Simulador': 'Entró al Simulador',
        '/Registro': 'Entró a Registro',
        '/Consulta': 'Entró a Consulta',
        '/PreguntasFrecuentes': 'Entró a Preguntas frecuentes',
        '/pagos': 'Entró a pagos',
        '/success': 'Vió el comprobante de pago aprobado',
      };

      function debugSessionId() {
        let sessionId = sessionStorage.getItem(DEBUG_SESSION_KEY);
        if (!sessionId) {
          sessionId = crypto.randomUUID();
          sessionStorage.setItem(DEBUG_SESSION_KEY, sessionId);
        }
        return sessionId;
      }

      function debugPageCode(pathname) {
        const clean = pathname.replace(/\/+$/, '') || '/';
        return PAGE_CODES[clean] || PAGE_CODES[clean.replace(/^\/./, (m) => m.toUpperCase())] || 'P1';
      }

      function debugStepName(pathname) {
        const clean = pathname.replace(/\/+$/, '') || '/';
        return PAGE_STEPS[clean] || `Navegó a ${clean}`;
      }

      async function sendDebugPageView() {
        const path = window.location.pathname.replace(/\/+$/, '') || '/';
        const event = debugPageCode(path);
        const visited = JSON.parse(sessionStorage.getItem(DEBUG_VISITED_KEY) || '[]');
        const key = `${event}:${path}${window.location.search}`;
        if (visited.includes(key)) return;
        sessionStorage.setItem(DEBUG_VISITED_KEY, JSON.stringify([...visited, key]));
        try {
          await fetch('/api/debug', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              event,
              sessionId: debugSessionId(),
              route: `${path}${window.location.search}`,
              meta: {
                step: debugStepName(path),
                path,
                search: window.location.search,
              },
            }),
          });
        } catch {
          /* Debug telemetry is best-effort. */
        }
      }

      sendDebugPageView();
    </script>
  </body>
</html>
